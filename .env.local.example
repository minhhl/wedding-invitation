# Supabase Configuration — only used by the static GitHub Pages export, where
# the RSVP form inserts straight into Supabase since there's no server to
# write to src/data/ (that's what normal `npm run dev` / `npm start` use).
# See "Database Setup (Supabase)" in README.md.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# /guest-management admin login — JSON array of accounts, each "admin" or "viewer"
AUTH_USERS=[{"username":"admin","password":"change-me","role":"admin"},{"username":"viewer","password":"change-me","role":"viewer"}]
# Random secret used to sign the session cookie, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Couple names & wedding date
NEXT_PUBLIC_GROOM_NAME=Hoàng Minh
NEXT_PUBLIC_BRIDE_NAME=Minh Ngọc
NEXT_PUBLIC_WEDDING_DATE=2026-09-20T00:00:00+07:00

# Site
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_SITE_NAME=Wedding of Hoàng Minh & Minh Ngọc
