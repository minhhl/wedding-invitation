# Supabase Configuration — the whole backend (guests, RSVP requests, admin
# login) lives here instead of local files, so the app works the same as a
# server (`npm run dev`/`start`) or as the static GitHub Pages export.
# See "Database Setup (Supabase)" in README.md.
NEXT_PUBLIC_SUPABASE_URL=https://mkxpkgxueddiuaehxnee.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_dvIuRC8JU4XSy9c-Ia46jg_bqk9T0-p

# ImageKit URL endpoint (Dashboard → URL Endpoints) — gallery photos are
# served from here so they're resized/compressed/format-converted on the fly.
# See src/lib/images.ts.
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Couple names & wedding date
NEXT_PUBLIC_GROOM_NAME=Hoàng Minh
NEXT_PUBLIC_BRIDE_NAME=Minh Ngọc
NEXT_PUBLIC_WEDDING_DATE=2026-09-20T00:00:00+07:00

# Site
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_SITE_NAME=Wedding of Hoàng Minh & Minh Ngọc
